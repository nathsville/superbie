APP_NAME="SuperBie - Lapor Pak Wali"
APP_ENV=local
APP_KEY=
# SECURITY: never enable debug in production (it leaks stack traces and env
# values). Local development may enable it; the shipped default is the safe
# production value.
APP_DEBUG=false
# FINAL (D-1): authoritative application timezone = Asia/Makassar (WITA/UTC+8).
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=superbie
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SECURITY: set to true when the app is served over HTTPS so the session
# cookie is only sent over TLS. Keep false for local HTTP development.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lapor.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# ─── Map / reverse geocoding ──────────────────────────────────────────────────
# OPTIONAL automatic "Lokasi / Alamat Detail" suggestion on the CITIZEN forms.
# Owner-approved scope/privacy deviation: coordinates are sent to a third-party
# geocoder ONLY when the citizen ticks the opt-in checkbox. Defaults live in
# config/map.php; the vars below only override them.
#
# Set MAP_GEOCODE_EMAIL to a real contact address in PRODUCTION — the OSM
# Nominatim usage policy requires it for anything beyond light use. The browser
# sends the Referer automatically, which Nominatim also requires.
# MAP_REVERSE_GEOCODE=true
# MAP_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# MAP_GEOCODE_EMAIL=
# MAP_GEOCODE_LOCALE=id
#
# Map view / tiles (optional overrides).
# MAP_DEFAULT_LAT=-4.0135
# MAP_DEFAULT_LNG=119.6255
# MAP_DEFAULT_ZOOM=13
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_MAX_ZOOM=19

# ─── WINDY weather (migrated legacy feature) ──────────────────────────────────
# All values are optional; sensible verified defaults live in config/weather.php.
#
# MULTI-LOCATION: monitored locations are defined as an ordered list in
# config/weather.php (`locations`), each with its own `adm4` code AND its own
# `marine_area_code` so land/wave data are scoped per location. The shipped
# default list covers Kota Parepare PLUS the four kecamatan of Kota Parepare
# (Ujung, Soreang, Bacukiki Barat, Bacukiki); the public picker appears whenever
# more than one entry is configured. The env vars below only customise the
# FIRST/default location (Kota Parepare). To monitor MORE locations, append
# entries to the `locations` array in config/weather.php — adding a location is
# a config change, not a code change. Do NOT add a location without a VERIFIED
# adm4 code and marine area code.
# WINDY_ENABLED=true
# WINDY_LOCATION_NAME="Kota Parepare"
# BMKG administrative-area code. Default 73.72.02.1001 = Kota Parepare / Ujung /
# Labukkang (VERIFIED against the live BMKG API on 2026-10-15).
# WINDY_BMKG_ADM4=73.72.02.1001
# WINDY_LATITUDE=-4.017522847
# WINDY_LONGITUDE=119.6249880584
# WINDY_BMKG_BASE_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
# WINDY_CACHE_TTL=1800
# WINDY_EMBED_ENABLED=true
# WINDY_SYNC_MAX_ATTEMPTS=6
# WINDY_SYNC_DECAY_MINUTES=10
# Marine (wave) source — BMKG maritime API.
# WINDY_MARINE_ENABLED=true
# BMKG sea-area code for the default location (VERIFIED: Parepare → P.AE.01).
# WINDY_MARINE_AREA_CODE=P.AE.01
# WINDY_MARINE_BASE_URL=https://maritim.bmkg.go.id/marine2026-data

# ─── PHASE S — SIPHP market module (native rebuild, manual entry) ───────────
# Owner decisions D-S1…D-S7 — see SIPHP_INTEGRATION_PLAN.md. Data is entered
# manually by Super Admin in the panel; there is NO scraping / iframe / sync
# with the legacy siphp-parepare.com site. All vars below are OPTIONAL overrides.
# Set false to take the public /siphp surface offline (returns 404).
# SIPHP_ENABLED=true
# Store photo uploads (public disk, generated filenames). Max size is a
# technical bound, not a business rule.
# SIPHP_STORE_PHOTO_MAX_KB=4096
# Source note shown next to market data on the public page.
# SIPHP_SOURCE_NOTE="Data harga pasar diinput manual oleh petugas."
